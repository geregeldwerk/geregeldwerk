# Mock is the default. The app runs and the tests pass without a key.
GEREGELDWERK_LLM_PROVIDER=mock
GEREGELDWERK_LLM_API_KEY=
# Optioneel endpoint van een OpenAI-compatibele provider. Geen productdomein.
GEREGELDWERK_LLM_BASE_URL=https://api.openai.com/v1
GEREGELDWERK_LLM_MODEL=gpt-4o-mini

# Optional path for the local JSON store. Defaults to data/store.json.
GEREGELDWERK_DATA_FILE=
